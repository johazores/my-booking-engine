model RentalLocation {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  name           String                   @db.VarChar(160)
  code           String                   @db.VarChar(32)
  addressLine1   String                   @db.VarChar(200)
  addressLine2   String?                  @db.VarChar(200)
  city           String                   @db.VarChar(120)
  region         String?                  @db.VarChar(120)
  postalCode     String?                  @db.VarChar(32)
  countryCode    String                   @db.Char(2)
  timeZone       String                   @db.VarChar(80)
  status         InventoryLifecycleStatus @default(ACTIVE)
  archivedAt     DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rental_locations_organization_fkey")
  units RentalUnit[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@map("rental_locations")
}

model RentalUnitType {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @db.Uuid
  name                  String                   @db.VarChar(160)
  code                  String                   @db.VarChar(32)
  description           String?                  @db.VarChar(1000)
  currency              String                   @db.Char(3)
  defaultDailyRateMinor Int
  status                InventoryLifecycleStatus @default(ACTIVE)
  archivedAt            DateTime?                @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rental_unit_types_organization_fkey")
  units       RentalUnit[]
  ratePeriods RentalRatePeriod[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@map("rental_unit_types")
}

model RentalUnit {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  unitTypeId     String                   @db.Uuid
  locationId     String?                  @db.Uuid
  name           String                   @db.VarChar(160)
  code           String                   @db.VarChar(32)
  description    String?                  @db.VarChar(1000)
  status         InventoryLifecycleStatus @default(ACTIVE)
  archivedAt     DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  unitType           RentalUnitType             @relation(fields: [unitTypeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  location           RentalLocation?            @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  availabilityBlocks RentalAvailabilityBlock[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, unitTypeId, status, name])
  @@index([organizationId, locationId, status, name])
  @@map("rental_units")
}

model RentalAvailabilityBlock {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  unitId         String   @db.Uuid
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  reason         String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  unit RentalUnit @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, unitId, startsOn, endsOn])
  @@map("rental_availability_blocks")
}

model RentalRatePeriod {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  unitTypeId     String   @db.Uuid
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  dailyRateMinor Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  unitType RentalUnitType @relation(fields: [unitTypeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, unitTypeId, startsOn, endsOn])
  @@map("rental_rate_periods")
}
