model RentalLocation {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  name           String                   @db.VarChar(160)
  code           String                   @db.VarChar(32)
  addressLine1   String                   @db.VarChar(200)
  addressLine2   String?                  @db.VarChar(200)
  city           String                   @db.VarChar(120)
  region         String?                  @db.VarChar(120)
  postalCode     String?                  @db.VarChar(32)
  countryCode    String                   @db.Char(2)
  timeZone       String                   @db.VarChar(80)
  status         InventoryLifecycleStatus @default(ACTIVE)
  archivedAt     DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rental_locations_organization_fkey")
  units        RentalUnit[]
  bookings     RentalBooking[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@map("rental_locations")
}

model RentalUnitType {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @db.Uuid
  name                  String                   @db.VarChar(160)
  code                   String                   @db.VarChar(32)
  description           String?                  @db.VarChar(1000)
  currency              String                   @db.Char(3)
  defaultDailyRateMinor Int
  status                InventoryLifecycleStatus @default(ACTIVE)
  archivedAt            DateTime?                @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rental_unit_types_organization_fkey")
  units        RentalUnit[]
  ratePeriods  RentalRatePeriod[]
  bookings     RentalBooking[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@map("rental_unit_types")
}

model RentalUnit {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  unitTypeId     String                   @db.Uuid
  locationId     String?                  @db.Uuid
  name           String                   @db.VarChar(160)
  code           String                   @db.VarChar(32)
  description    String?                  @db.VarChar(1000)
  status         InventoryLifecycleStatus @default(ACTIVE)
  archivedAt     DateTime?                @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  unitType                   RentalUnitType                    @relation(fields: [unitTypeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  location                   RentalLocation?                   @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  operationalState           RentalUnitOperationalState?
  maintenanceWorkOrders      RentalMaintenanceWorkOrder[]
  returnInspections          RentalReturnInspection[]          @relation("RentalReturnInspectionUnit")
  damageCases                RentalDamageCase[]                @relation("RentalDamageCaseUnit")
  availabilityBlocks         RentalAvailabilityBlock[]
  availabilityHolds          RentalAvailabilityHold[]
  bookings                   RentalBooking[]                   @relation("RentalBookingUnit")
  bookingAllocations         RentalBookingAllocation[]         @relation("RentalBookingAllocationUnit")
  sourceBookingSubstitutions RentalBookingUnitSubstitution[]   @relation("RentalBookingUnitSubstitutionSourceUnit")
  targetBookingSubstitutions RentalBookingUnitSubstitution[]   @relation("RentalBookingUnitSubstitutionTargetUnit")
  fulfillmentEvents          RentalBookingFulfillmentEvent[]   @relation("RentalBookingFulfillmentEventUnit")
  earlyReturnReleases        RentalBookingEarlyReturnRelease[] @relation("RentalBookingEarlyReturnReleaseUnit")

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, unitTypeId, status, name])
  @@index([organizationId, locationId, status, name])
  @@map("rental_units")
}

model RentalAvailabilityBlock {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  unitId         String   @db.Uuid
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  reason         String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  unit RentalUnit @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, unitId, startsOn, endsOn])
  @@map("rental_availability_blocks")
}

model RentalAvailabilityHold {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  unitId             String                 @db.Uuid
  startsOn           DateTime               @db.Date
  endsOn             DateTime               @db.Date
  status             AvailabilityHoldStatus @default(ACTIVE)
  expiresAt          DateTime               @db.Timestamptz(6)
  endedAt            DateTime?              @db.Timestamptz(6)
  idempotencyKey     String                 @db.VarChar(120)
  quotedCurrency     String?                @db.Char(3)
  quotedTotalMinor   BigInt?                @db.BigInt
  pricingFingerprint String?                @db.Char(64)
  pricingSnapshot    Json?
  pricingObservedAt  DateTime?              @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)

  unit    RentalUnit     @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  booking RentalBooking?

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, unitId, status, startsOn, endsOn])
  @@index([organizationId, status, expiresAt])
  @@map("rental_availability_holds")
}

model RentalRatePeriod {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  unitTypeId     String   @db.Uuid
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  dailyRateMinor Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  unitType RentalUnitType @relation(fields: [unitTypeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, unitTypeId, startsOn, endsOn])
  @@map("rental_rate_periods")
}

model RentalBooking {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @db.Uuid
  customerId           String                   @db.Uuid
  customerFirstName    String                   @db.VarChar(80)
  customerLastName     String                   @db.VarChar(80)
  customerEmail        String?                  @db.VarChar(320)
  customerPhone        String?                  @db.VarChar(40)
  holdId               String                   @db.Uuid
  unitId               String                   @db.Uuid
  unitTypeId           String                   @db.Uuid
  locationId           String                   @db.Uuid
  idempotencyKey       String                   @db.VarChar(120)
  status               BookingStatus            @default(CONFIRMED)
  startsOn             DateTime                 @db.Date
  endsOn               DateTime                 @db.Date
  currency             String                   @db.Char(3)
  totalMinor           BigInt                   @db.BigInt
  pricingFingerprint   String                   @db.Char(64)
  pricingSnapshot      Json
  pricingObservedAt    DateTime                 @db.Timestamptz(6)
  authorityFingerprint String                   @db.Char(64)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(6)
  confirmedAt          DateTime                 @db.Timestamptz(6)
  cancelledAt          DateTime?                @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_bookings_customer_fkey")
  hold RentalAvailabilityHold @relation(fields: [holdId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_bookings_hold_fkey")
  unit RentalUnit @relation("RentalBookingUnit", fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_bookings_unit_fkey")
  unitType RentalUnitType @relation(fields: [unitTypeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_bookings_unit_type_fkey")
  location RentalLocation @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_bookings_location_fkey")
  allocation RentalBookingAllocation?
  reschedules RentalBookingReschedule[]
  unitSubstitutions RentalBookingUnitSubstitution[]
  paymentTransactions RentalPaymentTransaction[]
  securityBondRequirement RentalSecurityBondRequirement?
  securityBondTransactions RentalSecurityBondTransaction[]
  securityBondForfeiture RentalSecurityBondForfeiture?
  fulfillmentEvents RentalBookingFulfillmentEvent[]
  earlyReturnRelease RentalBookingEarlyReturnRelease?
  returnInspection RentalReturnInspection?
  damageCase RentalDamageCase?

  @@unique([id, organizationId], map: "rental_bookings_id_organization_key")
  @@unique([organizationId, idempotencyKey], map: "rental_bookings_org_idempotency_key")
  @@unique([organizationId, holdId], map: "rental_bookings_org_hold_key")
  @@index([organizationId, status, createdAt], map: "rental_bookings_org_status_created_idx")
  @@index([organizationId, customerId, createdAt], map: "rental_bookings_customer_created_idx")
  @@index([organizationId, unitId, startsOn, endsOn], map: "rental_bookings_unit_dates_idx")
  @@map("rental_bookings")
}

model RentalBookingAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  bookingId      String   @db.Uuid
  unitId         String   @db.Uuid
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  booking RentalBooking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_booking_allocations_booking_fkey")
  unit    RentalUnit    @relation("RentalBookingAllocationUnit", fields: [unitId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_booking_allocations_unit_fkey")

  @@unique([organizationId, bookingId], map: "rental_booking_allocations_org_booking_key")
  @@index([organizationId, unitId, startsOn, endsOn], map: "rental_booking_allocations_unit_dates_idx")
  @@map("rental_booking_allocations")
}
