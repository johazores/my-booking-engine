enum HospitalityBookingPricingEvidenceSource {
  BOOKING_CONFIRMATION
  BOOKING_RESCHEDULE
  BOOKING_COMMERCIAL_MODIFICATION
  COMMERCIAL_AMENDMENT_TARGET
  COMMERCIAL_AMENDMENT_APPLY
}

model HospitalityBookingPricingEvidence {
  id                          String                                   @id @default(uuid()) @db.Uuid
  organizationId              String                                   @db.Uuid
  bookingId                   String                                   @db.Uuid
  commercialAmendmentId       String?                                  @db.Uuid
  evidenceKey                 String                                   @db.VarChar(220)
  source                      HospitalityBookingPricingEvidenceSource
  bookingVersion              DateTime                                 @db.Timestamptz(6)
  propertyId                  String                                   @db.Uuid
  roomTypeId                  String                                   @db.Uuid
  ratePlanId                  String                                   @db.Uuid
  arrivalDate                 DateTime                                 @db.Date
  departureDate               DateTime                                 @db.Date
  quantity                    Int
  addonSelections             Json
  currency                    String                                   @db.Char(3)
  accommodationSubtotalMinor  BigInt                                   @db.BigInt
  taxTotalMinor               BigInt                                   @db.BigInt
  feeTotalMinor               BigInt                                   @db.BigInt
  addonTotalMinor             BigInt                                   @db.BigInt
  totalMinor                  BigInt                                   @db.BigInt
  pricingFingerprint          String                                   @db.Char(64)
  pricingBreakdown            Json
  createdAt                   DateTime                                 @default(now()) @db.Timestamptz(6)

  organization         Organization                            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_booking_pricing_evidence_organization_fkey")
  booking              HospitalityBooking                     @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_booking_pricing_evidence_booking_fkey")
  property             HospitalityProperty                    @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_booking_pricing_evidence_property_fkey")
  roomType             HospitalityRoomType                    @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_booking_pricing_evidence_room_type_fkey")
  ratePlan             HospitalityRatePlan                    @relation(fields: [ratePlanId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_booking_pricing_evidence_rate_plan_fkey")
  commercialAmendment HospitalityBookingCommercialAmendment? @relation(fields: [commercialAmendmentId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_booking_pricing_evidence_amendment_fkey")
  invoicePreparations  HospitalityInvoicePreparation[]
  issuedInvoices       HospitalityIssuedInvoice[]
  issuedAdjustmentNote  HospitalityIssuedAdjustmentNote?

  @@unique([id, organizationId], map: "hospitality_booking_pricing_evidence_id_org_key")
  @@unique([id, bookingId, organizationId], map: "hospitality_booking_pricing_evidence_id_booking_org_key")
  @@unique([organizationId, evidenceKey], map: "hospitality_booking_pricing_evidence_org_key")
  @@index([organizationId, bookingId, createdAt], map: "hospitality_booking_pricing_evidence_org_booking_created_idx")
  @@index([organizationId, commercialAmendmentId, source], map: "hospitality_booking_pricing_evidence_org_amendment_source_idx")
  @@map("hospitality_booking_pricing_evidence")
}
