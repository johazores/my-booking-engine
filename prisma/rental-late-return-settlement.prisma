model RentalLateReturnSettlementTransaction {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @db.Uuid
  bookingId               String                   @db.Uuid
  assessmentId            String                   @db.Uuid
  idempotencyKey          String                   @db.VarChar(120)
  requestFingerprint      String                   @db.Char(64)
  kind                    PaymentTransactionKind
  status                  PaymentTransactionStatus @default(PENDING)
  providerCode            String                   @db.VarChar(40)
  providerReference       String                   @db.VarChar(160)
  sourceProviderReference String?                  @db.VarChar(160)
  currency                String                   @db.Char(3)
  amountMinor             BigInt
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)

  booking    RentalBooking              @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_late_return_settlement_transactions_booking_fkey")
  assessment RentalLateReturnAssessment @relation(fields: [assessmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_late_return_settlement_transactions_assessment_fkey")

  @@unique([id, organizationId], map: "rental_late_return_settlement_transactions_id_org_key")
  @@unique([organizationId, idempotencyKey], map: "rental_late_return_settlement_transactions_org_idempotency_key")
  @@unique([organizationId, providerCode, providerReference], map: "rental_late_return_settlement_org_provider_ref_key")
  @@unique([organizationId, assessmentId, kind], map: "rental_late_return_settlement_org_assessment_kind_key")
  @@index([organizationId, bookingId, createdAt], map: "rental_late_return_settlement_transactions_booking_created_idx")
  @@map("rental_late_return_settlement_transactions")
}
