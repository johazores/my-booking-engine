enum HospitalitySupplierReservationOperationStatus {
  PREPARED
  SUBMITTING
  CONFIRMED
  AMBIGUOUS
  RECONCILING
  REVIEW_REQUIRED
  FAILED
}

enum HospitalitySupplierReservationAttemptKind {
  CREATE
  RECONCILE
  RECOVERY_WRITE
}

enum HospitalitySupplierReservationAttemptStatus {
  STARTED
  SUCCEEDED
  REVIEW_REQUIRED
  FAILED
  AMBIGUOUS
  NOT_FOUND
}

model HospitalitySupplierReservationOperation {
  id                           String                                         @id @default(uuid()) @db.Uuid
  organizationId               String                                         @db.Uuid
  integrationId                String                                         @db.Uuid
  integrationCredentialVersion Int
  idempotencyKey               String                                         @db.VarChar(120)
  requestFingerprint           String                                         @db.Char(64)
  requestFingerprintVersion    Int?                                           @default(2)
  providerCode                 String                                         @db.VarChar(64)
  supplierPropertyReference    String                                         @db.VarChar(4096)
  supplierOfferReference       String                                         @db.VarChar(4096)
  offerFingerprint             String                                         @db.Char(64)
  termsFingerprint             String                                         @db.Char(64)
  reservationPayloadFingerprint String                                        @db.Char(64)
  currency                     String                                         @db.Char(3)
  expectedTotalMinor           BigInt                                         @db.BigInt
  arrivalDate                  DateTime                                       @db.Date
  departureDate                DateTime                                       @db.Date
  rooms                        Int
  adults                       Int
  childAges                    Int[]
  status                       HospitalitySupplierReservationOperationStatus  @default(PREPARED)
  providerReservationReference String?                                        @db.VarChar(512)
  supplierConfirmationReference String?                                       @db.VarChar(512)
  providerRecoveryReference    String?                                        @db.VarChar(1024)
  lastProviderCorrelationId    String?                                        @db.VarChar(512)
  lastFailureCode              String?                                        @db.VarChar(64)
  lastFailureRetryable         Boolean?
  reviewAcceptedAt             DateTime?                                      @db.Timestamptz(6)
  reviewAcceptedByUserId       String?                                        @db.Uuid
  reviewAcceptedAttemptSequence Int?
  reviewAcceptedPriceChange    Boolean?
  reviewAcceptedGuaranteeChange Boolean?
  reviewAcceptedCurrency       String?                                        @db.Char(3)
  reviewAcceptedTotalMinor     BigInt?                                        @db.BigInt
  reviewAcceptedOfferFingerprint String?                                      @db.Char(64)
  reviewAcceptedTermsFingerprint String?                                      @db.Char(64)
  reviewAcceptedAuthorityFingerprint String?                                  @db.Char(64)
  reviewAcceptanceFingerprint  String?                                        @db.Char(64)
  attemptCount                 Int                                            @default(0)
  lastAttemptAt                DateTime?                                      @db.Timestamptz(6)
  reconciledAt                 DateTime?                                      @db.Timestamptz(6)
  createdAt                    DateTime                                       @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                                       @updatedAt @db.Timestamptz(6)
  integration                  Integration                                    @relation(fields: [integrationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  attempts                     HospitalitySupplierReservationAttempt[]

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, integrationId, providerReservationReference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, integrationId, status, createdAt])
  @@map("hospitality_supplier_reservation_operations")
}

model HospitalitySupplierReservationAttempt {
  id                      String                                      @id @default(uuid()) @db.Uuid
  organizationId          String                                      @db.Uuid
  reservationId           String                                      @db.Uuid
  sequence                Int
  kind                    HospitalitySupplierReservationAttemptKind
  status                  HospitalitySupplierReservationAttemptStatus @default(STARTED)
  providerCorrelationId   String?                                     @db.VarChar(512)
  normalizedFailureCode   String?                                     @db.VarChar(64)
  startedAt               DateTime                                    @default(now()) @db.Timestamptz(6)
  leaseStartedAt          DateTime?                                   @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  providerRequestStartedAt DateTime?                                  @db.Timestamptz(6)
  completedAt             DateTime?                                   @db.Timestamptz(6)
  reservation             HospitalitySupplierReservationOperation     @relation(fields: [reservationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reviewAcceptanceConsumption HospitalitySupplierReservationReviewAcceptanceHistory? @relation("SupplierReservationReviewAcceptanceConsumedAttempt")

  @@unique([organizationId, reservationId, sequence])
  @@index([organizationId, reservationId, startedAt])
  @@index([organizationId, status, startedAt])
  @@map("hospitality_supplier_reservation_attempts")
}

model HospitalitySupplierReservationReviewAcceptanceHistory {
  id                           String                                 @id(map: "supplier_review_acceptance_history_pkey") @default(uuid()) @db.Uuid
  organizationId               String                                 @db.Uuid
  reservationId                String                                 @db.Uuid
  reviewAttemptSequence        Int
  acceptedAt                   DateTime                               @db.Timestamptz(6)
  acceptedByUserId             String                                 @db.Uuid
  reason                       String                                 @db.VarChar(64)
  acceptPriceChange            Boolean
  acceptGuaranteeChange        Boolean
  currency                     String                                 @db.Char(3)
  acceptedTotalMinor           BigInt                                 @db.BigInt
  acceptedOfferFingerprint     String                                 @db.Char(64)
  acceptedTermsFingerprint     String                                 @db.Char(64)
  acceptedAuthorityFingerprint String                                 @db.Char(64)
  acceptanceFingerprint        String                                 @db.Char(64)
  consumedAt                   DateTime                               @db.Timestamptz(6)
  consumedAttemptSequence      Int
  createdAt                    DateTime                               @default(now()) @db.Timestamptz(6)
  consumedAttempt              HospitalitySupplierReservationAttempt   @relation("SupplierReservationReviewAcceptanceConsumedAttempt", fields: [organizationId, reservationId, consumedAttemptSequence], references: [organizationId, reservationId, sequence], onDelete: Restrict, map: "supplier_review_acceptance_history_attempt_fkey")

  @@unique([organizationId, reservationId, reviewAttemptSequence], map: "supplier_review_acceptance_history_review_key")
  @@unique([organizationId, reservationId, consumedAttemptSequence], map: "supplier_review_acceptance_history_consumed_attempt_key")
  @@unique([organizationId, reservationId, acceptanceFingerprint], map: "supplier_review_acceptance_history_fingerprint_key")
  @@index([organizationId, reservationId, createdAt], map: "supplier_review_acceptance_history_created_idx")
  @@map("hospitality_supplier_reservation_review_acceptance_history")
}
