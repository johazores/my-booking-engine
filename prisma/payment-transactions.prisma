enum PaymentTransactionKind {
  OFFLINE_PAYMENT
  AUTHORIZATION
  CAPTURE
  REFUND
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

model PaymentTransaction {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @db.Uuid
  bookingId          String                   @db.Uuid
  idempotencyKey     String                   @db.VarChar(120)
  requestFingerprint String?                  @db.Char(64)
  kind               PaymentTransactionKind
  status             PaymentTransactionStatus @default(PENDING)
  providerCode       String                   @db.VarChar(40)
  providerReference  String                   @db.VarChar(160)
  currency           String                   @db.Char(3)
  amountMinor        BigInt
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking      HospitalityBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, providerCode, providerReference])
  @@index([organizationId, bookingId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("payment_transactions")
}
