model InvoiceIssuerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  version         Int
  fingerprint     String   @db.Char(64)
  countryCode     String   @db.Char(2)
  profileSnapshot Json
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([id, organizationId])
  @@unique([organizationId, version])
  @@index([organizationId, createdAt])
  @@map("invoice_issuer_profiles")
}

model HospitalityInvoicePreparation {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @db.Uuid
  bookingId                  String   @db.Uuid
  pricingEvidenceId          String   @db.Uuid
  issuerProfileId            String   @db.Uuid
  preparationKey             String   @db.VarChar(220)
  currency                   String   @db.Char(3)
  accommodationSubtotalMinor BigInt   @db.BigInt
  taxTotalMinor              BigInt   @db.BigInt
  feeTotalMinor              BigInt   @db.BigInt
  addonTotalMinor            BigInt   @db.BigInt
  totalMinor                 BigInt   @db.BigInt
  pricingFingerprint         String   @db.Char(64)
  issuerFingerprint          String   @db.Char(64)
  recipientFingerprint       String?  @db.Char(64)
  documentFingerprint        String   @db.Char(64)
  preparationSnapshot        Json
  createdByUserId            String   @db.Uuid
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([id, organizationId])
  @@unique([id, bookingId, organizationId])
  @@unique([organizationId, preparationKey])
  @@unique([organizationId, documentFingerprint])
  @@index([organizationId, bookingId, createdAt])
  @@index([organizationId, issuerProfileId, createdAt])
  @@map("hospitality_invoice_preparations")
}

model HospitalityInvoiceNumberSequence {
  organizationId   String   @db.Uuid
  jurisdictionCode String   @db.VarChar(16)
  documentType     String   @db.VarChar(32)
  nextValue        BigInt   @default(1) @db.BigInt
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@id([organizationId, jurisdictionCode, documentType])
  @@map("hospitality_invoice_number_sequences")
}

model HospitalityIssuedInvoice {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @db.Uuid
  bookingId                  String   @db.Uuid
  preparationId              String   @db.Uuid
  pricingEvidenceId          String   @db.Uuid
  issuerProfileId            String   @db.Uuid
  jurisdictionCode           String   @db.VarChar(16)
  documentType               String   @db.VarChar(32)
  documentNumber             String   @db.VarChar(64)
  sequenceValue              BigInt   @db.BigInt
  issuedByUserId             String   @db.Uuid
  issuedAt                   DateTime @db.Timestamptz(6)
  currency                   String   @db.Char(3)
  accommodationSubtotalMinor BigInt   @db.BigInt
  taxTotalMinor              BigInt   @db.BigInt
  feeTotalMinor              BigInt   @db.BigInt
  addonTotalMinor            BigInt   @db.BigInt
  totalMinor                 BigInt   @db.BigInt
  preparationFingerprint     String   @db.Char(64)
  pricingFingerprint         String   @db.Char(64)
  issuerFingerprint          String   @db.Char(64)
  recipientFingerprint       String   @db.Char(64)
  documentFingerprint        String   @db.Char(64)
  documentSnapshot           Json
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([id, organizationId])
  @@unique([id, bookingId, organizationId])
  @@unique([organizationId, preparationId])
  @@unique([organizationId, jurisdictionCode, documentNumber])
  @@unique([organizationId, jurisdictionCode, documentType, sequenceValue])
  @@unique([organizationId, documentFingerprint])
  @@index([organizationId, bookingId, issuedAt])
  @@index([organizationId, issuerProfileId, issuedAt])
  @@map("hospitality_issued_invoices")
}

model HospitalityIssuedAdjustmentNote {
  id                                 String   @id @default(uuid()) @db.Uuid
  organizationId                     String   @db.Uuid
  bookingId                          String   @db.Uuid
  sourceInvoiceId                    String   @db.Uuid
  refundTransactionId                String?  @unique(map: "hospitality_adj_notes_refund_transaction_key") @db.Uuid
  commercialAmendmentId              String?  @unique(map: "hospitality_adj_notes_commercial_amendment_key") @db.Uuid
  targetPricingEvidenceId            String?  @unique(map: "hospitality_adj_notes_target_pricing_key") @db.Uuid
  predecessorAdjustmentNoteId        String?  @unique(map: "hospitality_adj_notes_predecessor_key") @db.Uuid
  predecessorSourceAdjustmentOrdinal Int?
  sourceAdjustmentOrdinal            Int      @default(1)
  jurisdictionCode                   String   @db.VarChar(16)
  documentType                       String   @db.VarChar(32)
  documentNumber                     String   @db.VarChar(64)
  sequenceValue                      BigInt   @db.BigInt
  issuedByUserId                     String   @db.Uuid
  issuedAt                           DateTime @db.Timestamptz(6)
  currency                           String   @db.Char(3)
  adjustmentType                     String   @default("DECREASING") @db.VarChar(16)
  adjustmentReason                   String   @db.VarChar(32)
  decreaseSubtotalMinor              BigInt   @db.BigInt
  decreaseTaxMinor                   BigInt   @db.BigInt
  decreaseTotalMinor                 BigInt   @db.BigInt
  increaseSubtotalMinor              BigInt   @default(0) @db.BigInt
  increaseTaxMinor                   BigInt   @default(0) @db.BigInt
  increaseTotalMinor                 BigInt   @default(0) @db.BigInt
  sourceInvoiceFingerprint           String   @db.Char(64)
  issuerFingerprint                  String   @db.Char(64)
  recipientFingerprint               String   @db.Char(64)
  documentFingerprint                String   @db.Char(64)
  documentSnapshot                   Json
  createdAt                          DateTime @default(now()) @db.Timestamptz(6)

  @@unique([id, organizationId])
  @@unique([id, bookingId, organizationId, sourceInvoiceId, sourceAdjustmentOrdinal, adjustmentReason], map: "hospitality_adj_notes_chain_reference_key")
  @@unique([organizationId, sourceInvoiceId, sourceAdjustmentOrdinal])
  @@unique([organizationId, jurisdictionCode, documentNumber])
  @@unique([organizationId, jurisdictionCode, documentType, sequenceValue])
  @@unique([organizationId, documentFingerprint])
  @@index([organizationId, bookingId, issuedAt])
  @@index([organizationId, sourceInvoiceId, issuedAt])
  @@index([organizationId, commercialAmendmentId, issuedAt])
  @@map("hospitality_issued_adjustment_notes")
}
