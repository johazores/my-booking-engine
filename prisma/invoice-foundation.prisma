model InvoiceIssuerProfile {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  version         Int
  fingerprint     String   @db.Char(64)
  countryCode     String   @db.Char(2)
  profileSnapshot Json
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  invoicePreparations HospitalityInvoicePreparation[]
  issuedInvoices      HospitalityIssuedInvoice[]

  @@unique([id, organizationId], map: "invoice_issuer_profiles_id_org_key")
  @@unique([organizationId, version], map: "invoice_issuer_profiles_org_version_key")
  @@index([organizationId, createdAt], map: "invoice_issuer_profiles_org_created_idx")
  @@map("invoice_issuer_profiles")
}

model HospitalityInvoicePreparation {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @db.Uuid
  bookingId                  String   @db.Uuid
  pricingEvidenceId          String   @db.Uuid
  issuerProfileId            String   @db.Uuid
  preparationKey             String   @db.VarChar(220)
  currency                   String   @db.Char(3)
  accommodationSubtotalMinor BigInt   @db.BigInt
  taxTotalMinor              BigInt   @db.BigInt
  feeTotalMinor              BigInt   @db.BigInt
  addonTotalMinor            BigInt   @db.BigInt
  totalMinor                 BigInt   @db.BigInt
  pricingFingerprint         String   @db.Char(64)
  issuerFingerprint          String   @db.Char(64)
  recipientFingerprint       String?  @db.Char(64)
  documentFingerprint        String   @db.Char(64)
  preparationSnapshot        Json
  createdByUserId            String   @db.Uuid
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)

  pricingEvidence HospitalityBookingPricingEvidence @relation(fields: [pricingEvidenceId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_invoice_preparations_pricing_evidence_fkey")
  issuerProfile   InvoiceIssuerProfile               @relation(fields: [issuerProfileId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_invoice_preparations_issuer_profile_fkey")
  issuedInvoice   HospitalityIssuedInvoice?

  @@unique([id, organizationId], map: "hospitality_invoice_preparations_id_org_key")
  @@unique([id, bookingId, organizationId], map: "hospitality_invoice_preparations_id_booking_org_key")
  @@unique([organizationId, preparationKey], map: "hospitality_invoice_preparations_org_key")
  @@unique([organizationId, documentFingerprint], map: "hospitality_invoice_preparations_org_fingerprint_key")
  @@index([organizationId, bookingId, createdAt], map: "hospitality_invoice_preparations_org_booking_created_idx")
  @@index([organizationId, issuerProfileId, createdAt], map: "hospitality_invoice_preparations_org_issuer_created_idx")
  @@map("hospitality_invoice_preparations")
}

model HospitalityInvoiceNumberSequence {
  organizationId   String   @db.Uuid
  jurisdictionCode String   @db.VarChar(16)
  documentType     String   @db.VarChar(32)
  nextValue        BigInt   @default(1) @db.BigInt
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@id([organizationId, jurisdictionCode, documentType], map: "hospitality_invoice_number_sequences_pkey")
  @@map("hospitality_invoice_number_sequences")
}

model HospitalityIssuedInvoice {
  id                         String   @id @default(uuid()) @db.Uuid
  organizationId             String   @db.Uuid
  bookingId                  String   @db.Uuid
  preparationId              String   @db.Uuid
  pricingEvidenceId          String   @db.Uuid
  issuerProfileId            String   @db.Uuid
  jurisdictionCode           String   @db.VarChar(16)
  documentType               String   @db.VarChar(32)
  documentNumber             String   @db.VarChar(64)
  sequenceValue              BigInt   @db.BigInt
  issuedByUserId             String   @db.Uuid
  issuedAt                   DateTime @db.Timestamptz(6)
  currency                   String   @db.Char(3)
  accommodationSubtotalMinor BigInt   @db.BigInt
  taxTotalMinor              BigInt   @db.BigInt
  feeTotalMinor              BigInt   @db.BigInt
  addonTotalMinor            BigInt   @db.BigInt
  totalMinor                 BigInt   @db.BigInt
  preparationFingerprint     String   @db.Char(64)
  pricingFingerprint         String   @db.Char(64)
  issuerFingerprint          String   @db.Char(64)
  recipientFingerprint       String   @db.Char(64)
  documentFingerprint        String   @db.Char(64)
  documentSnapshot           Json
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)

  preparation     HospitalityInvoicePreparation     @relation(fields: [preparationId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_issued_invoices_preparation_fkey")
  pricingEvidence HospitalityBookingPricingEvidence @relation(fields: [pricingEvidenceId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_issued_invoices_pricing_evidence_fkey")
  issuerProfile   InvoiceIssuerProfile               @relation(fields: [issuerProfileId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_issued_invoices_issuer_profile_fkey")
  adjustmentNotes HospitalityIssuedAdjustmentNote[]

  @@unique([id, organizationId], map: "hospitality_issued_invoices_id_org_key")
  @@unique([id, bookingId, organizationId], map: "hospitality_issued_invoices_id_booking_org_key")
  @@unique([organizationId, preparationId], map: "hospitality_issued_invoices_org_preparation_key")
  @@unique([organizationId, jurisdictionCode, documentNumber], map: "hospitality_issued_invoices_org_jurisdiction_number_key")
  @@unique([organizationId, jurisdictionCode, documentType, sequenceValue], map: "hospitality_issued_invoices_org_jurisdiction_type_sequence_key")
  @@unique([organizationId, documentFingerprint], map: "hospitality_issued_invoices_org_fingerprint_key")
  @@index([organizationId, bookingId, issuedAt], map: "hospitality_issued_invoices_org_booking_issued_idx")
  @@index([organizationId, issuerProfileId, issuedAt], map: "hospitality_issued_invoices_org_issuer_issued_idx")
  @@map("hospitality_issued_invoices")
}

model HospitalityIssuedAdjustmentNote {
  id                                 String   @id @default(uuid()) @db.Uuid
  organizationId                     String   @db.Uuid
  bookingId                          String   @db.Uuid
  sourceInvoiceId                    String   @db.Uuid
  refundTransactionId                String?  @unique(map: "hospitality_adj_notes_refund_transaction_key") @db.Uuid
  commercialAmendmentId              String?  @unique(map: "hospitality_adj_notes_commercial_amendment_key") @db.Uuid
  targetPricingEvidenceId            String?  @unique(map: "hospitality_adj_notes_target_pricing_key") @db.Uuid
  predecessorAdjustmentNoteId        String?  @unique(map: "hospitality_adj_notes_predecessor_key") @db.Uuid
  predecessorSourceAdjustmentOrdinal Int?
  sourceAdjustmentOrdinal            Int      @default(1)
  jurisdictionCode                   String   @db.VarChar(16)
  documentType                       String   @db.VarChar(32)
  documentNumber                     String   @db.VarChar(64)
  sequenceValue                      BigInt   @db.BigInt
  issuedByUserId                     String   @db.Uuid
  issuedAt                           DateTime @db.Timestamptz(6)
  currency                           String   @db.Char(3)
  adjustmentType                     String   @default("DECREASING") @db.VarChar(16)
  adjustmentReason                   String   @db.VarChar(32)
  decreaseSubtotalMinor              BigInt   @db.BigInt
  decreaseTaxMinor                   BigInt   @db.BigInt
  decreaseTotalMinor                 BigInt   @db.BigInt
  increaseSubtotalMinor              BigInt   @default(0) @db.BigInt
  increaseTaxMinor                   BigInt   @default(0) @db.BigInt
  increaseTotalMinor                 BigInt   @default(0) @db.BigInt
  sourceInvoiceFingerprint           String   @db.Char(64)
  issuerFingerprint                  String   @db.Char(64)
  recipientFingerprint               String   @db.Char(64)
  documentFingerprint                String   @db.Char(64)
  documentSnapshot                   Json
  createdAt                          DateTime @default(now()) @db.Timestamptz(6)

  sourceInvoice            HospitalityIssuedInvoice               @relation(fields: [sourceInvoiceId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_adj_notes_source_invoice_booking_fkey")
  refundTransaction        PaymentTransaction?                     @relation(fields: [refundTransactionId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_adj_notes_refund_booking_fkey")
  commercialAmendment      HospitalityBookingCommercialAmendment? @relation(fields: [commercialAmendmentId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_adj_notes_commercial_amendment_fkey")
  targetPricingEvidence    HospitalityBookingPricingEvidence?     @relation(fields: [targetPricingEvidenceId, bookingId, organizationId], references: [id, bookingId, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_adj_notes_target_pricing_fkey")
  predecessorAdjustmentNote HospitalityIssuedAdjustmentNote?      @relation("HospitalityIssuedAdjustmentNotePredecessor", fields: [predecessorAdjustmentNoteId, bookingId, organizationId, sourceInvoiceId, predecessorSourceAdjustmentOrdinal], references: [id, bookingId, organizationId, sourceInvoiceId, sourceAdjustmentOrdinal], onDelete: Restrict, onUpdate: Cascade, map: "hospitality_adj_notes_predecessor_fkey")
  successorAdjustmentNote   HospitalityIssuedAdjustmentNote?       @relation("HospitalityIssuedAdjustmentNotePredecessor")

  @@unique([id, organizationId], map: "hospitality_issued_adjustment_notes_id_org_key")
  @@unique([id, bookingId, organizationId, sourceInvoiceId, sourceAdjustmentOrdinal], map: "hospitality_adj_notes_chain_reference_any_reason_key")
  @@unique([id, bookingId, organizationId, sourceInvoiceId, sourceAdjustmentOrdinal, adjustmentReason], map: "hospitality_adj_notes_chain_reference_key")
  @@unique([organizationId, sourceInvoiceId, sourceAdjustmentOrdinal], map: "hospitality_adj_notes_org_source_ordinal_key")
  @@unique([organizationId, jurisdictionCode, documentNumber], map: "hospitality_issued_adjustment_notes_org_jurisdiction_number_key")
  @@unique([organizationId, jurisdictionCode, documentType, sequenceValue], map: "hospitality_issued_adjustment_notes_org_jurisdiction_type_sequence_key")
  @@unique([organizationId, documentFingerprint], map: "hospitality_issued_adjustment_notes_org_fingerprint_key")
  @@index([organizationId, bookingId, issuedAt], map: "hospitality_issued_adjustment_notes_org_booking_issued_idx")
  @@index([organizationId, sourceInvoiceId, issuedAt], map: "hospitality_issued_adjustment_notes_org_source_issued_idx")
  @@index([organizationId, commercialAmendmentId, issuedAt], map: "hospitality_adj_notes_org_commercial_issued_idx")
  @@map("hospitality_issued_adjustment_notes")
}
