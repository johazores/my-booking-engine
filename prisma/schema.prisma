generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationKind {
  HOTEL
  RESORT
  TRAVEL_AGENCY
  TOUR_OPERATOR
  APPOINTMENT_BUSINESS
  RENTAL_BUSINESS
  MARKETPLACE
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformRole {
  USER
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum InventoryLifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum RoomOperationalStatus {
  ACTIVE
  OUT_OF_SERVICE
  ARCHIVED
}

enum AvailabilityHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
}

model Organization {
  id                          String                          @id @default(uuid()) @db.Uuid
  slug                        String                          @unique @db.VarChar(63)
  name                        String                          @db.VarChar(160)
  kind                        OrganizationKind
  status                      OrganizationStatus              @default(ACTIVE)
  timezone                    String                          @default("UTC") @db.VarChar(80)
  currency                    String                          @default("USD") @db.VarChar(3)
  logoUrl                     String?                         @db.VarChar(2048)
  faviconUrl                  String?                         @db.VarChar(2048)
  primaryColor                String                          @default("#2563eb") @db.Char(7)
  secondaryColor              String                          @default("#0d1626") @db.Char(7)
  accentColor                 String                          @default("#20c997") @db.Char(7)
  fontFamily                  String                          @default("INTER") @db.VarChar(20)
  contactEmail                String?                         @db.VarChar(320)
  contactPhone                String?                         @db.VarChar(40)
  websiteUrl                  String?                         @db.VarChar(2048)
  emailFromName               String?                         @db.VarChar(160)
  emailReplyTo                String?                         @db.VarChar(320)
  publicBookingTitle          String?                         @db.VarChar(160)
  publicBookingDescription    String?                         @db.VarChar(500)
  customDomain                String?                         @unique @db.VarChar(253)
  createdAt                   DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                        @updatedAt @db.Timestamptz(6)
  deletedAt                   DateTime?                       @db.Timestamptz(6)
  memberships                 OrganizationMembership[]
  customers                   Customer[]
  hospitalityProperties       HospitalityProperty[]
  hospitalityAmenities        HospitalityAmenity[]
  hospitalityAvailabilityWindows HospitalityAvailabilityWindow[]
  hospitalityAvailabilityHolds HospitalityAvailabilityHold[]
  auditEvents                 AuditEvent[]

  @@index([status, deletedAt])
  @@index([kind])
  @@map("organizations")
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique @db.VarChar(320)
  displayName        String?                  @db.VarChar(160)
  status             UserStatus               @default(ACTIVE)
  platformRole       PlatformRole             @default(USER)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(6)
  memberships        OrganizationMembership[]
  passwordCredential PasswordCredential?
  authSessions       AuthSession[]
  auditEvents        AuditEvent[]              @relation("AuditActor")

  @@index([status])
  @@index([platformRole, status])
  @@map("users")
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  role           OrganizationRole @default(STAFF)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([organizationId, role, status])
  @@map("organization_memberships")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  firstName      String         @db.VarChar(80)
  lastName       String         @db.VarChar(80)
  email          String?        @db.VarChar(320)
  phone          String?        @db.VarChar(40)
  notes          String?        @db.Text
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?      @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, email])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, lastName, firstName])
  @@map("customers")
}

model HospitalityProperty {
  id                 String                       @id @default(uuid()) @db.Uuid
  organizationId     String                       @db.Uuid
  name               String                       @db.VarChar(160)
  code               String                       @db.VarChar(32)
  status             InventoryLifecycleStatus     @default(ACTIVE)
  timezone           String                       @db.VarChar(80)
  addressLine1       String?                      @db.VarChar(200)
  city               String?                      @db.VarChar(120)
  region             String?                      @db.VarChar(120)
  postalCode         String?                      @db.VarChar(24)
  countryCode        String                       @db.Char(2)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)
  archivedAt         DateTime?                    @db.Timestamptz(6)
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roomTypes          HospitalityRoomType[]
  amenityAssignments HospitalityPropertyAmenity[]
  images             HospitalityPropertyImage[]
  ratePlans          HospitalityRatePlan[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status, name])
  @@map("hospitality_properties")
}

model HospitalityRoomType {
  id                  String                          @id @default(uuid()) @db.Uuid
  organizationId      String                          @db.Uuid
  propertyId          String                          @db.Uuid
  name                String                          @db.VarChar(120)
  code                String                          @db.VarChar(32)
  status              InventoryLifecycleStatus        @default(ACTIVE)
  maxOccupancy        Int
  bedsDescription     String?                         @db.VarChar(160)
  createdAt           DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                        @updatedAt @db.Timestamptz(6)
  archivedAt          DateTime?                       @db.Timestamptz(6)
  property            HospitalityProperty             @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  rooms               HospitalityRoom[]
  amenityAssignments  HospitalityRoomTypeAmenity[]
  images              HospitalityRoomTypeImage[]
  ratePlanAssignments HospitalityRoomTypeRatePlan[]
  restrictions        HospitalityRestriction[]
  availabilityWindows HospitalityAvailabilityWindow[]
  availabilityHolds   HospitalityAvailabilityHold[]

  @@unique([propertyId, code])
  @@unique([id, propertyId, organizationId])
  @@index([organizationId, status, name])
  @@index([propertyId, status])
  @@map("hospitality_room_types")
}

model HospitalityRoom {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  propertyId     String                @db.Uuid
  roomTypeId     String                @db.Uuid
  code           String                @db.VarChar(32)
  floor          String?               @db.VarChar(40)
  status         RoomOperationalStatus @default(ACTIVE)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?             @db.Timestamptz(6)
  roomType       HospitalityRoomType   @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict)

  @@unique([propertyId, code])
  @@index([organizationId, status, code])
  @@index([roomTypeId, status])
  @@map("hospitality_rooms")
}

model HospitalityAmenity {
  id                  String                       @id @default(uuid()) @db.Uuid
  organizationId      String                       @db.Uuid
  name                String                       @db.VarChar(120)
  code                String                       @db.VarChar(32)
  status              InventoryLifecycleStatus     @default(ACTIVE)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(6)
  archivedAt          DateTime?                    @db.Timestamptz(6)
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  propertyAssignments HospitalityPropertyAmenity[]
  roomTypeAssignments HospitalityRoomTypeAmenity[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status, name])
  @@map("hospitality_amenities")
}

model HospitalityPropertyAmenity {
  organizationId String              @db.Uuid
  propertyId     String              @db.Uuid
  amenityId      String              @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  property       HospitalityProperty @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  amenity        HospitalityAmenity  @relation(fields: [amenityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([organizationId, propertyId, amenityId])
  @@index([organizationId, amenityId])
  @@map("hospitality_property_amenities")
}

model HospitalityRoomTypeAmenity {
  organizationId String              @db.Uuid
  propertyId     String              @db.Uuid
  roomTypeId     String              @db.Uuid
  amenityId      String              @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  roomType       HospitalityRoomType @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Cascade)
  amenity        HospitalityAmenity  @relation(fields: [amenityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([organizationId, roomTypeId, amenityId])
  @@index([organizationId, amenityId])
  @@index([propertyId, roomTypeId])
  @@map("hospitality_room_type_amenities")
}

model HospitalityPropertyImage {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  propertyId     String              @db.Uuid
  url            String              @db.VarChar(2048)
  altText        String              @db.VarChar(200)
  sortOrder      Int                 @default(0)
  isPrimary      Boolean             @default(false)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  property       HospitalityProperty @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, propertyId, isPrimary, sortOrder])
  @@map("hospitality_property_images")
}

model HospitalityRoomTypeImage {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  propertyId     String              @db.Uuid
  roomTypeId     String              @db.Uuid
  url            String              @db.VarChar(2048)
  altText        String              @db.VarChar(200)
  sortOrder      Int                 @default(0)
  isPrimary      Boolean             @default(false)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  roomType       HospitalityRoomType @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, propertyId, roomTypeId, isPrimary, sortOrder])
  @@map("hospitality_room_type_images")
}

model HospitalityRatePlan {
  id                  String                        @id @default(uuid()) @db.Uuid
  organizationId      String                        @db.Uuid
  propertyId          String                        @db.Uuid
  name                String                        @db.VarChar(120)
  code                String                        @db.VarChar(32)
  description         String?                       @db.VarChar(300)
  status              InventoryLifecycleStatus      @default(ACTIVE)
  createdAt           DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                      @updatedAt @db.Timestamptz(6)
  archivedAt          DateTime?                     @db.Timestamptz(6)
  property            HospitalityProperty           @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  roomTypeAssignments HospitalityRoomTypeRatePlan[]
  restrictions        HospitalityRestriction[]
  availabilityHolds   HospitalityAvailabilityHold[]

  @@unique([propertyId, code])
  @@unique([id, propertyId, organizationId])
  @@index([organizationId, status, name])
  @@index([propertyId, status, name])
  @@map("hospitality_rate_plans")
}

model HospitalityRoomTypeRatePlan {
  organizationId String              @db.Uuid
  propertyId     String              @db.Uuid
  roomTypeId     String              @db.Uuid
  ratePlanId     String              @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  roomType       HospitalityRoomType @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Cascade)
  ratePlan       HospitalityRatePlan @relation(fields: [ratePlanId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Cascade)

  @@id([organizationId, roomTypeId, ratePlanId])
  @@index([organizationId, ratePlanId])
  @@index([propertyId, roomTypeId])
  @@map("hospitality_room_type_rate_plans")
}

model HospitalityRestriction {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @db.Uuid
  propertyId        String                   @db.Uuid
  ratePlanId        String                   @db.Uuid
  roomTypeId        String?                  @db.Uuid
  startDate         DateTime                 @db.Date
  endDate           DateTime                 @db.Date
  minStayNights     Int?
  maxStayNights     Int?
  closedToArrival   Boolean                  @default(false)
  closedToDeparture Boolean                  @default(false)
  status            InventoryLifecycleStatus @default(ACTIVE)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)
  archivedAt        DateTime?                @db.Timestamptz(6)
  ratePlan          HospitalityRatePlan      @relation(fields: [ratePlanId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict)
  roomType          HospitalityRoomType?     @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict)

  @@unique([id, propertyId, organizationId])
  @@index([organizationId, propertyId, ratePlanId, status, startDate])
  @@index([organizationId, propertyId, roomTypeId, status, startDate])
  @@map("hospitality_restrictions")
}

model HospitalityAvailabilityWindow {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  propertyId     String                   @db.Uuid
  roomTypeId     String                   @db.Uuid
  startDate      DateTime                 @db.Date
  endDate        DateTime                 @db.Date
  capacityLimit  Int
  status         InventoryLifecycleStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?                @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roomType       HospitalityRoomType      @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict)

  @@unique([id, propertyId, organizationId])
  @@index([organizationId, propertyId, roomTypeId, status, startDate])
  @@map("hospitality_availability_windows")
}

model HospitalityAvailabilityHold {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  propertyId     String                 @db.Uuid
  roomTypeId     String                 @db.Uuid
  ratePlanId     String                 @db.Uuid
  idempotencyKey String                 @db.VarChar(120)
  arrivalDate    DateTime               @db.Date
  departureDate  DateTime               @db.Date
  quantity       Int
  status         AvailabilityHoldStatus @default(ACTIVE)
  expiresAt      DateTime               @db.Timestamptz(6)
  endedAt        DateTime?              @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roomType       HospitalityRoomType    @relation(fields: [roomTypeId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict)
  ratePlan       HospitalityRatePlan    @relation(fields: [ratePlanId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, propertyId, roomTypeId, status, arrivalDate, departureDate])
  @@index([organizationId, status, expiresAt])
  @@map("hospitality_availability_holds")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorUserId    String       @db.Uuid
  action         String       @db.VarChar(120)
  resourceType   String       @db.VarChar(80)
  resourceId     String       @db.VarChar(120)
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser      User         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}
