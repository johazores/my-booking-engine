generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationKind {
  HOTEL
  RESORT
  TRAVEL_AGENCY
  TOUR_OPERATOR
  APPOINTMENT_BUSINESS
  RENTAL_BUSINESS
  MARKETPLACE
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PlatformRole {
  USER
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

model Organization {
  id                       String             @id @default(uuid()) @db.Uuid
  slug                     String             @unique @db.VarChar(63)
  name                     String             @db.VarChar(160)
  kind                     OrganizationKind
  status                   OrganizationStatus @default(ACTIVE)
  timezone                 String             @default("UTC") @db.VarChar(80)
  currency                 String             @default("USD") @db.VarChar(3)
  logoUrl                  String?            @db.VarChar(2048)
  faviconUrl               String?            @db.VarChar(2048)
  primaryColor             String             @default("#2563eb") @db.Char(7)
  secondaryColor           String             @default("#0d1626") @db.Char(7)
  accentColor              String             @default("#20c997") @db.Char(7)
  fontFamily               String             @default("INTER") @db.VarChar(20)
  contactEmail             String?            @db.VarChar(320)
  contactPhone             String?            @db.VarChar(40)
  websiteUrl               String?            @db.VarChar(2048)
  emailFromName            String?            @db.VarChar(160)
  emailReplyTo             String?            @db.VarChar(320)
  publicBookingTitle       String?            @db.VarChar(160)
  publicBookingDescription String?            @db.VarChar(500)
  customDomain             String?            @unique @db.VarChar(253)
  createdAt                DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt                DateTime?          @db.Timestamptz(6)
  memberships              OrganizationMembership[]
  customers                Customer[]
  auditEvents              AuditEvent[]

  @@index([status, deletedAt])
  @@index([kind])
  @@map("organizations")
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique @db.VarChar(320)
  displayName        String?                  @db.VarChar(160)
  status             UserStatus               @default(ACTIVE)
  platformRole       PlatformRole             @default(USER)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(6)
  memberships        OrganizationMembership[]
  passwordCredential PasswordCredential?
  authSessions       AuthSession[]
  auditEvents        AuditEvent[]              @relation("AuditActor")

  @@index([status])
  @@index([platformRole, status])
  @@map("users")
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  role           OrganizationRole @default(STAFF)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([organizationId, role, status])
  @@map("organization_memberships")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  firstName      String         @db.VarChar(80)
  lastName       String         @db.VarChar(80)
  email          String?        @db.VarChar(320)
  phone          String?        @db.VarChar(40)
  notes          String?        @db.Text
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  archivedAt     DateTime?      @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, email])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, lastName, firstName])
  @@map("customers")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorUserId    String       @db.Uuid
  action         String       @db.VarChar(120)
  resourceType   String       @db.VarChar(80)
  resourceId     String       @db.VarChar(120)
  beforeData     Json?
  afterData      Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser      User         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}
