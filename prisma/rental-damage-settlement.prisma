model RentalDamageSettlementTransaction {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @db.Uuid
  bookingId               String                   @db.Uuid
  damageCaseId            String                   @db.Uuid
  liabilityDecisionId     String                   @db.Uuid
  idempotencyKey          String                   @db.VarChar(120)
  requestFingerprint      String                   @db.Char(64)
  kind                    PaymentTransactionKind
  status                  PaymentTransactionStatus @default(PENDING)
  providerCode            String                   @db.VarChar(40)
  providerReference       String                   @db.VarChar(160)
  sourceProviderReference String?                  @db.VarChar(160)
  currency                String                   @db.Char(3)
  amountMinor             BigInt
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)

  booking           RentalBooking                  @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_damage_settlement_transactions_booking_fkey")
  damageCase        RentalDamageCase               @relation(fields: [damageCaseId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_damage_settlement_transactions_damage_case_fkey")
  liabilityDecision RentalDamageLiabilityDecision @relation(fields: [liabilityDecisionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "rental_damage_settlement_transactions_liability_fkey")

  @@unique([id, organizationId], map: "rental_damage_settlement_transactions_id_org_key")
  @@unique([organizationId, idempotencyKey], map: "rental_damage_settlement_transactions_org_idempotency_key")
  @@unique([organizationId, providerCode, providerReference], map: "rental_damage_settlement_transactions_org_provider_reference_key")
  @@unique([organizationId, liabilityDecisionId, kind], map: "rental_damage_settlement_transactions_org_liability_kind_key")
  @@index([organizationId, bookingId, createdAt], map: "rental_damage_settlement_transactions_booking_created_idx")
  @@index([organizationId, damageCaseId, createdAt], map: "rental_damage_settlement_transactions_case_created_idx")
  @@map("rental_damage_settlement_transactions")
}
