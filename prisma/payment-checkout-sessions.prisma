enum PaymentCheckoutSessionStatus {
  OPEN
  COMPLETED
  EXPIRED
}

model PaymentCheckoutSession {
  id                       String                       @id @default(uuid()) @db.Uuid
  organizationId           String                       @db.Uuid
  bookingId                String                       @db.Uuid
  publicPrincipalId        String                       @db.Uuid
  paymentTransactionId     String                       @db.Uuid
  providerCode             String                       @db.VarChar(40)
  providerReference        String                       @db.VarChar(160)
  providerPaymentReference String?                      @db.VarChar(160)
  status                   PaymentCheckoutSessionStatus @default(OPEN)
  expiresAt                DateTime                     @db.Timestamptz(6)
  completedAt              DateTime?                    @db.Timestamptz(6)
  expiredAt                DateTime?                    @db.Timestamptz(6)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, providerCode, providerReference])
  @@unique([organizationId, paymentTransactionId])
  @@index([organizationId, bookingId, status])
  @@index([organizationId, expiresAt])
  @@map("payment_checkout_sessions")
}
