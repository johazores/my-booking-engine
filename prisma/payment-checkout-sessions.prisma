enum PaymentCheckoutSessionStatus {
  OPEN
  COMPLETED
  EXPIRED
}

model PaymentCheckoutSession {
  id                       String                       @id @default(uuid()) @db.Uuid
  organizationId           String                       @db.Uuid
  bookingId                String                       @db.Uuid
  publicPrincipalId        String                       @db.Uuid
  paymentTransactionId     String                       @db.Uuid
  providerCode             String                       @db.VarChar(40)
  providerReference        String                       @db.VarChar(160)
  providerPaymentReference String?                      @db.VarChar(160)
  status                   PaymentCheckoutSessionStatus @default(OPEN)
  expiresAt                DateTime                     @db.Timestamptz(6)
  completedAt              DateTime?                    @db.Timestamptz(6)
  expiredAt                DateTime?                    @db.Timestamptz(6)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                     @updatedAt @db.Timestamptz(6)

  publicPrincipal    PublicBookingPrincipal @relation(fields: [publicPrincipalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_checkout_sessions_principal_fkey")
  paymentTransaction PaymentTransaction      @relation(fields: [paymentTransactionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "payment_checkout_sessions_payment_transaction_fkey")

  @@unique([organizationId, providerCode, providerReference], map: "payment_checkout_sessions_org_provider_reference_key")
  @@unique([organizationId, paymentTransactionId], map: "payment_checkout_sessions_org_payment_transaction_key")
  @@index([organizationId, bookingId, status], map: "payment_checkout_sessions_org_booking_status_idx")
  @@index([organizationId, expiresAt], map: "payment_checkout_sessions_org_expiry_idx")
  @@map("payment_checkout_sessions")
}
