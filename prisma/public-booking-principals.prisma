model PublicBookingPrincipal {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  expiresAt      DateTime @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "public_booking_principals_organization_fkey")
  holdOwnerships    PublicBookingHoldOwnership[]
  bookingOwnerships PublicBookingBookingOwnership[]
  auditEvents       PublicBookingAuditEvent[]
  checkoutSessions  PaymentCheckoutSession[]

  @@unique([id, organizationId])
  @@index([organizationId, expiresAt], map: "public_booking_principals_org_expiry_idx")
  @@map("public_booking_principals")
}

model PublicBookingHoldOwnership {
  organizationId String   @db.Uuid
  holdId         String   @db.Uuid
  principalId    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  principal PublicBookingPrincipal       @relation(fields: [principalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "public_booking_hold_owner_principal_fkey")
  hold      HospitalityAvailabilityHold @relation(fields: [holdId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "public_booking_hold_owner_hold_fkey")

  @@id([organizationId, holdId])
  @@index([organizationId, principalId], map: "public_booking_hold_owner_principal_idx")
  @@map("public_booking_hold_ownership")
}

model PublicBookingBookingOwnership {
  organizationId     String   @db.Uuid
  bookingId          String   @db.Uuid
  principalId        String   @db.Uuid
  requestFingerprint String   @db.Char(64)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  principal PublicBookingPrincipal @relation(fields: [principalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "public_booking_booking_owner_principal_fkey")
  booking   HospitalityBooking     @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "public_booking_booking_owner_booking_fkey")

  @@id([organizationId, bookingId])
  @@index([organizationId, principalId], map: "public_booking_booking_owner_principal_idx")
  @@map("public_booking_booking_ownership")
}

model PublicBookingAuditEvent {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  actorPrincipalId String   @db.Uuid
  action           String   @db.VarChar(120)
  resourceType     String   @db.VarChar(80)
  resourceId       String   @db.VarChar(120)
  beforeData       Json?
  afterData        Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  actorPrincipal PublicBookingPrincipal @relation(fields: [actorPrincipalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "public_booking_audit_principal_fkey")

  @@index([organizationId, createdAt], map: "public_booking_audit_org_created_idx")
  @@index([organizationId, actorPrincipalId, createdAt], map: "public_booking_audit_actor_created_idx")
  @@index([resourceType, resourceId], map: "public_booking_audit_resource_idx")
  @@map("public_booking_audit_events")
}
