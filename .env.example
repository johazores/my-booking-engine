DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sf?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sf_test?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SF_INTEGRATION_MASTER_KEY="replace-with-32-byte-base64url-key"
# Separate deployment secret for opaque public hold capabilities and tenant-bound request idempotency.
# Generate with the same randomBytes command above. Never expose this value to browser code.
SF_PUBLIC_BOOKING_SECRET="replace-with-32-byte-base64url-key"
